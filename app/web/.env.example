# Copy to .env.local for local development. Never commit real values.
# All variables are exposed to the browser bundle (Vite only inlines VITE_* vars) — no secrets here.

# Base URL of the Dreamhouse API (app/api). Empty = same origin; the Vite dev server
# proxies /api/* to VITE_DEV_API_PROXY so the browser never needs CORS locally.
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY=http://localhost:3000

# Authentication: "stub" (local, any user/password accepted, no network) or "cognito".
VITE_AUTH_MODE=stub
# Required when VITE_AUTH_MODE=cognito (values come from infra/ Terraform outputs).
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
