# syntax=docker/dockerfile:1
# Development image used by the root docker-compose.yml (Vite dev server with HMR). The source
# tree is bind-mounted at /workspace/app/web (salesforce/ read-only next to it, for the tests
# that compare against the source app) and node_modules lives in a named volume seeded from this image;
# scripts/dev-entrypoint.sh reinstalls when package-lock.json changes. The web app ships to
# S3 + CloudFront as static files, so there is no production image.
FROM node:22-alpine
ENV NODE_ENV=development \
    HOME=/tmp \
    npm_config_cache=/tmp/npm-cache \
    npm_config_update_notifier=false
WORKDIR /workspace/app/web
COPY package.json package-lock.json ./
RUN npm ci \
    && sha256sum package-lock.json > node_modules/.package-lock.sha256 \
    && chmod -R a+rwX node_modules
COPY scripts/dev-entrypoint.sh ./scripts/dev-entrypoint.sh
EXPOSE 5173
ENTRYPOINT ["sh", "/workspace/app/web/scripts/dev-entrypoint.sh"]
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
