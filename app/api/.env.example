# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL connection used by Prisma (ORM + migrations).
DATABASE_URL=postgresql://dreamhouse:dreamhouse@localhost:5432/dreamhouse?schema=public

# Optional: name/ARN of an AWS Secrets Manager secret whose JSON body holds any of the
# variables above (e.g. {"DATABASE_URL": "..."}). Values set in the environment win.
# AWS_SECRETS_MANAGER_SECRET_ID=dreamhouse/api
# AWS_REGION=us-east-1

# Geocoding callout (GeocodingService in Apex -> geocoding module here).
# Nominatim usage policy: identify the app (User-Agent), max 1 request/s, cache results.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search?format=json
GEOCODING_USER_AGENT=dreamhouse-api (local dev)
# GEOCODING_REFERER=http://localhost:5173
GEOCODING_TIMEOUT_MS=10000
GEOCODING_MAX_RETRIES=2
GEOCODING_MIN_INTERVAL_MS=1000
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_CACHE_MAX_ENTRIES=1000
# Set to 1 to run the live Nominatim smoke test: GEOCODING_LIVE_SMOKE=1 npm test -- geocoding.live
# GEOCODING_LIVE_SMOKE=0

# Salesforce Files (FileUtilities.createFile -> POST /files). Unset FILES_BUCKET keeps the file
# bodies under FILES_LOCAL_DIR on disk; on ECS the task definition sets the private S3 bucket.
# FILES_BUCKET=dreamhouse-demo-files
FILES_LOCAL_DIR=.data/files
FILES_MAX_INLINE_BYTES=6291456
FILES_PRESIGNED_URL_TTL_SECONDS=900

# SampleDataController.importSampleData (POST /sample-data/import) deletes every property, broker
# and contact. Allowed by default outside production and off RDS; set explicitly to override.
# SAMPLE_DATA_IMPORT_ENABLED=true
# HS256 secret of the test bearer tokens (tests/parity/fixtures/users.ts); ignored in production.
# AUTH_TEST_JWT_SECRET=dreamhouse-characterisation
