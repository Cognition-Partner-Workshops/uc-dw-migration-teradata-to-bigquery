{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_liveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          }
        },
        "summary": "Liveness: the process is up (no dependency checks)",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessDto"
                }
              }
            }
          }
        },
        "summary": "Readiness: PostgreSQL reachable through Prisma",
        "tags": [
          "health"
        ]
      }
    },
    "/properties": {
      "get": {
        "description": "Port of `@AuraEnabled(cacheable=true) PropertyController.getPagedPropertyList` (used by propertyTileList). Same filter semantics as the SOQL: case-insensitive `%searchKey%` on name, city or tags; inclusive `maxPrice` / `minBedrooms` / `minBathrooms` bounds; ordered by price ascending.",
        "operationId": "properties_getPagedPropertyList",
        "parameters": [
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 9,
              "type": "number"
            }
          },
          {
            "name": "pageNumber",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "searchKey",
            "required": false,
            "in": "query",
            "description": "Matches name, city or tags (SOQL `LIKE %searchKey%`)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "schema": {
              "default": 9999999,
              "type": "number"
            }
          },
          {
            "name": "minBedrooms",
            "required": false,
            "in": "query",
            "schema": {
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "minBathrooms",
            "required": false,
            "in": "query",
            "schema": {
              "default": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedPropertiesDto"
                }
              }
            }
          }
        },
        "summary": "Paged, filtered property list",
        "tags": [
          "properties"
        ]
      }
    },
    "/properties/{id}/pictures": {
      "get": {
        "description": "Port of `@AuraEnabled(cacheable=true) PropertyController.getPictures` (used by propertyCarousel): PNG/JPG/GIF files linked to the property, oldest first. `[]` when none (Apex returned null).",
        "operationId": "properties_getPictures",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PropertyPictureDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Pictures attached to a property",
        "tags": [
          "properties"
        ]
      }
    },
    "/geocoding/addresses": {
      "post": {
        "description": "Port of `@InvocableMethod GeocodingService.geocodeAddresses` (called from the Create_property flow). Returns one Coordinates entry per input address, in order; `{lat: null, lon: null}` for a blank address, an unknown address or an upstream failure (the Apex callout swallowed non-200 answers).",
        "operationId": "geocoding_geocodeAddresses",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeocodeAddressesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CoordinatesDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Geocode one or more addresses",
        "tags": [
          "geocoding"
        ]
      }
    },
    "/geocode": {
      "post": {
        "description": "Single-address form of `geocodeAddresses` for the UI (Create_property wizard address screen). Nominatim (OpenStreetMap) usage policy applies: requests are spaced 1/s and results are cached server-side.",
        "operationId": "geocoding_geocode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeocodingAddressDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoordinatesDto"
                }
              }
            }
          }
        },
        "summary": "Geocode a single address",
        "tags": [
          "geocoding"
        ]
      }
    },
    "/brokers": {
      "get": {
        "description": "Replaces the Broker__c list view / tab.",
        "operationId": "brokers_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BrokerDto"
                  }
                }
              }
            }
          },
          "501": {
            "description": "Not ported yet (UNT3-19)"
          }
        },
        "summary": "List brokers",
        "tags": [
          "brokers"
        ]
      }
    },
    "/brokers/{id}": {
      "get": {
        "description": "Replaces `lightning/uiRecordApi getRecord` on Broker__c (brokerCard LWC).",
        "operationId": "brokers_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrokerDto"
                }
              }
            }
          },
          "501": {
            "description": "Not ported yet (UNT3-19)"
          }
        },
        "summary": "Get a broker",
        "tags": [
          "brokers"
        ]
      }
    },
    "/contacts": {
      "get": {
        "operationId": "contacts_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContactDto"
                  }
                }
              }
            }
          },
          "501": {
            "description": "Not ported yet (UNT3-19)"
          }
        },
        "summary": "List contacts",
        "tags": [
          "contacts"
        ]
      }
    },
    "/files": {
      "post": {
        "description": "Port of `@AuraEnabled FileUtilities.createFile(base64data, filename, recordId)` (Property record page picture upload). Stores the body in the files bucket and inserts the `files` row linked to the record; the file then shows up in `GET /properties/{id}/pictures` and is served by `GET /files/{id}`. Bodies larger than FILES_MAX_INLINE_BYTES go through `POST /files/presigned-upload` first and are finalised here with `uploadKey` instead of `base64Data`.",
        "operationId": "files_createFile",
        "parameters": [
          {
            "name": "authorization",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFileDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileCreatedDto"
                }
              }
            }
          },
          "400": {
            "description": "Blank or invalid filename / base64Data (Apex AuraHandledException)"
          },
          "404": {
            "description": "recordId does not exist (Apex: ContentDocumentLink insert failed)"
          },
          "413": {
            "description": "Decoded body exceeds FILES_MAX_INLINE_BYTES"
          }
        },
        "summary": "Upload a file and link it to a record",
        "tags": [
          "files"
        ]
      }
    },
    "/files/presigned-upload": {
      "post": {
        "description": "Returns a short-lived pre-signed `PUT` URL into the files bucket. After the upload succeeds, call `POST /files` with the returned `uploadKey` to create the file row (no counterpart in Apex, which was limited by request size).",
        "operationId": "files_createPresignedUpload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresignedUploadRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignedUploadDto"
                }
              }
            }
          },
          "404": {
            "description": "recordId does not exist"
          },
          "501": {
            "description": "Deployment has no S3 files bucket (FILES_BUCKET unset)"
          }
        },
        "summary": "Pre-signed S3 upload for large files",
        "tags": [
          "files"
        ]
      }
    },
    "/files/{id}": {
      "get": {
        "description": "Body of the file behind a `files` row (`ContentVersion.VersionData`). With the S3 bucket this answers `302` to a pre-signed URL; without it the API streams the object itself.",
        "operationId": "files_getFile",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File body (local storage)",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/gif": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to a pre-signed S3 URL"
          },
          "404": {
            "description": "No such file"
          }
        },
        "summary": "Download a file",
        "tags": [
          "files"
        ]
      }
    },
    "/sample-data/import": {
      "post": {
        "description": "Port of `@AuraEnabled SampleDataController.importSampleData` (Settings tab, sampleDataImporter LWC): deletes every property, broker and contact, then inserts the `sample_data_*` static resources, all in one transaction. Requires the `dreamhouse-admin` group and is refused unless the deployment allows it (SAMPLE_DATA_IMPORT_ENABLED).",
        "operationId": "sampleData_importSampleData",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleDataImportResultDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Import disabled on this deployment, or caller is not a dreamhouse-admin"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Reset and reload the sample data set (admin only)",
        "tags": [
          "sample-data"
        ]
      }
    }
  },
  "info": {
    "title": "Dreamhouse API",
    "description": "Dreamhouse API — NestJS + Prisma on PostgreSQL; target of the Salesforce (dreamhouse-lwc) migration",
    "version": "0.1.0",
    "contact": {},
    "license": {
      "name": "CC0-1.0",
      "url": "https://creativecommons.org/publicdomain/zero/1.0/"
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "properties",
      "description": "Property__c — PropertyController, Property record page, Create_property flow"
    },
    {
      "name": "brokers",
      "description": "Broker__c — Broker record page, brokerCard"
    },
    {
      "name": "contacts",
      "description": "Contact (standard object; sample data only)"
    },
    {
      "name": "files",
      "description": "ContentVersion / ContentDocumentLink — FileUtilities"
    },
    {
      "name": "geocoding",
      "description": "GeocodingService (Nominatim callout)"
    },
    {
      "name": "sample-data",
      "description": "SampleDataController — sampleDataImporter"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "example": "dreamhouse-api"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "uptimeSeconds": {
            "type": "number",
            "example": 12.3
          },
          "timestamp": {
            "type": "string",
            "example": "2026-10-06T07:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "uptimeSeconds",
          "timestamp"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "checks": {
            "type": "object",
            "example": {
              "database": "up"
            },
            "description": "Per-dependency state; `down` entries carry the error message in `errors`."
          },
          "errors": {
            "type": "object",
            "example": {
              "database": "connection refused"
            }
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "PropertySummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Property__c.Name"
          },
          "address": {
            "type": "string",
            "description": "Address__c",
            "nullable": true
          },
          "city": {
            "type": "string",
            "description": "City__c",
            "nullable": true
          },
          "state": {
            "type": "string",
            "description": "State__c",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Description__c",
            "nullable": true
          },
          "price": {
            "type": "number",
            "description": "Price__c",
            "nullable": true
          },
          "baths": {
            "type": "number",
            "description": "Baths__c",
            "nullable": true
          },
          "beds": {
            "type": "number",
            "description": "Beds__c",
            "nullable": true
          },
          "thumbnail": {
            "type": "string",
            "description": "Thumbnail__c",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "description": "Location__Latitude__s",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "description": "Location__Longitude__s",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "city",
          "state",
          "description",
          "price",
          "baths",
          "beds",
          "thumbnail",
          "latitude",
          "longitude"
        ]
      },
      "PagedPropertiesDto": {
        "type": "object",
        "properties": {
          "pageSize": {
            "type": "number",
            "example": 9
          },
          "pageNumber": {
            "type": "number",
            "example": 1
          },
          "totalItemCount": {
            "type": "number",
            "example": 42
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertySummaryDto"
            }
          }
        },
        "required": [
          "pageSize",
          "pageNumber",
          "totalItemCount",
          "records"
        ]
      },
      "PropertyPictureDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "fileExtension": {
            "type": "string",
            "description": "ContentVersion.FileExtension"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "title",
          "fileExtension",
          "url"
        ]
      },
      "GeocodingAddressDto": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "postalcode": {
            "type": "string"
          }
        }
      },
      "GeocodeAddressesDto": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GeocodingAddressDto"
            }
          }
        },
        "required": [
          "addresses"
        ]
      },
      "CoordinatesDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "object",
            "nullable": true
          },
          "lon": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "BrokerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Broker__c.Name"
          },
          "brokerId": {
            "type": "string",
            "description": "Broker_Id__c"
          },
          "title": {
            "type": "string",
            "description": "Title__c"
          },
          "email": {
            "type": "string",
            "description": "Email__c",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "description": "Phone__c"
          },
          "mobilePhone": {
            "type": "string",
            "description": "Mobile_Phone__c"
          },
          "picture": {
            "type": "string",
            "description": "Picture__c",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ContactDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName"
        ]
      },
      "CreateFileDto": {
        "type": "object",
        "properties": {
          "base64Data": {
            "type": "string",
            "description": "File body, base64 encoded (ContentVersion.VersionData). Missing padding and a `data:` URL prefix are accepted. Required unless `uploadKey` is given; decoded size is capped by FILES_MAX_INLINE_BYTES."
          },
          "filename": {
            "type": "string",
            "description": "ContentVersion.Title / PathOnClient",
            "example": "house01.jpg"
          },
          "recordId": {
            "type": "string",
            "format": "uuid",
            "description": "Record the file is linked to (ContentDocumentLink.LinkedEntityId)"
          },
          "uploadKey": {
            "type": "string",
            "description": "Key returned by POST /files/presigned-upload once the PUT to S3 completed",
            "example": "uploads/4f0c.../8e1a.../house01.jpg"
          }
        },
        "required": [
          "filename",
          "recordId"
        ]
      },
      "FileCreatedDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Equivalent of the returned ContentDocumentLink.Id"
          },
          "url": {
            "type": "string",
            "description": "API path that serves the file (same value GET /properties/{id}/pictures returns)",
            "example": "/files/4f0c6a9e-1b2d-4c3e-8f90-123456789abc"
          },
          "title": {
            "type": "string",
            "description": "ContentVersion.Title (filename without extension)"
          },
          "fileType": {
            "type": "string",
            "description": "ContentDocument.FileType (upper-case extension)",
            "example": "JPG"
          },
          "size": {
            "type": "number",
            "description": "Stored size in bytes"
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "fileType",
          "size"
        ]
      },
      "PresignedUploadRequestDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "ContentVersion.Title / PathOnClient",
            "example": "house01.jpg"
          },
          "recordId": {
            "type": "string",
            "format": "uuid",
            "description": "Record the file will be linked to"
          },
          "contentType": {
            "type": "string",
            "description": "MIME type the client will send; derived from the filename when omitted",
            "example": "image/jpeg"
          }
        },
        "required": [
          "filename",
          "recordId"
        ]
      },
      "PresignedUploadDto": {
        "type": "object",
        "properties": {
          "uploadKey": {
            "type": "string",
            "description": "Pass back as `uploadKey` to POST /files after the PUT succeeded"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Pre-signed S3 URL to PUT the file body to"
          },
          "method": {
            "type": "string",
            "enum": [
              "PUT"
            ]
          },
          "headers": {
            "type": "object",
            "description": "Headers the PUT must carry (signed into the URL)",
            "example": {
              "Content-Type": "image/jpeg"
            }
          },
